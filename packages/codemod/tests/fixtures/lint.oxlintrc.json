{
  "plugins": [
    "jsdoc",
    "typescript"
  ],
  "rules": {
    "jsdoc/require-param": "error",
    "no-unused-vars": "error",
    "sort-imports": [
      "error",
      {
        "ignoreCase": true,
        "ignoreDeclarationSort": true
      }
    ],
    "typescript/consistent-type-imports": "error"
  }
}
