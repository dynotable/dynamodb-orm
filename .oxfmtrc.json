{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "bracketSpacing": false,
  "printWidth": 100,
  "trailingComma": "none",
  "tabWidth": 2,
  "sortPackageJson": false,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "docs/plans/**",
    ".equivalence-local/**",
    "packages/codemod/tests/fixtures/**"
  ]
}
